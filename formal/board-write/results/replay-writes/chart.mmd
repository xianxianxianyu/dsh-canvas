---
title: "Saving a board and noticing overwritten changes"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: saved
    lg1: refused
    lg2: working
    lg3: Breaks ReplaySafe
    lg4: Path to the ReplaySafe bug
  }
  class lg0 teal
  class lg1 orange
  class lg2 blue
  class lg3 breaks
  class lg4 bugPath
  state "At the same time" as all {
    state "YourSave" as r0 {
      s0: Ready to save your note
      s1: Checking the file version
      s2: Board not found
      s3: Reading the board
      s4: Checking and applying your note
      s5: Invalid board#59; nothing overwritten
      s6: Ready to publish your note
      s7: Your note is saved#59; remembering intent
      s8: Your save is complete#59; reply pending
      s9: You were told it is saved
      s10: Reply lost#59; you can resend
      s11: Replay wrote again
      [*] --> s0
      s0 --> s1: you save a note
      s1 --> s2: the file is absent
      s1 --> s3: the file is found
      s3 --> s4: the text is read
      s4 --> s5: invalid JSON is refused
      s4 --> s6: your absolute operation is applied
      s6 --> s7: the version is checked under the file lock
      s7 --> s8: the host retains applied intent before replying
      s8 --> s9: you receive done
      s8 --> s10: the reply is lost
      s9 --> s1: you resend the same note
      s10 --> s1: you resend the same note
      s6 --> s11: the version is checked under the file lock
    }
    --
    state "Agent" as r1 {
      s12: Agent finished
      [*] --> s12
    }
  }
  classDef breaks fill:#ffecee,stroke:#e72e3b,stroke-width:2.5px,color:#cd2834
  class s0 blue
  class s0 bugPath
  class s1 blue
  class s1 bugPath
  class s2 orange
  class s3 blue
  class s3 bugPath
  class s4 blue
  class s4 bugPath
  class s5 orange
  class s6 blue
  class s6 bugPath
  class s7 blue
  class s7 bugPath
  class s8 blue
  class s8 bugPath
  class s9 teal
  class s10 orange
  class s10 bugPath
  class s11 breaks
  class s11 bugPath
  class s12 bugPath
